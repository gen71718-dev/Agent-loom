# ---- 应用 ----
APP_NAME=AgentLoom
APP_ENV=dev
LOG_LEVEL=INFO

# ---- 模型（任何 OpenAI 兼容端点都行：OpenAI / DeepSeek / 通义 / 本地 vLLM）----
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 走第三方兼容端点时填，例如 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0

# ---- Redis（必须是 Redis Stack，带 RediSearch 模块）----
REDIS_URL=redis://localhost:6379/0
# redis（生产形态：进程重启/多副本都不丢记忆）或 memory（本地开发，免 Docker）
CHECKPOINTER=redis
# 会话状态在 Redis 里的存活时间，避免无限增长
REDIS_CHECKPOINT_TTL_MINUTES=1440

# ---- LangSmith 可观测性（不开就留 false，代码不会上报）----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agent-loom

# ---- 允许的跨域来源，逗号分隔；* 表示全部 ----
CORS_ORIGINS=*

# ---- 鉴权 ----
# 格式：key:user_id,key:user_id。Key 至少 16 位。
# 留空则拒绝所有 /chat 与 /threads 请求（fail closed，不会默认放行）。
# 生产环境请用强随机值：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=local-dev-key-0001:dev
